# Copy to deployment/.env locally, never commit real keys.
# Bash: source deployment/.env after editing, or enter the key using read -s.
export OPENAI_API_KEY=''
# Optional OpenAI-compatible endpoint; leave unset for the SDK default.
# export OPENAI_BASE_URL='https://api.openai.com/v1'
export CUDA_VISIBLE_DEVICES=0
